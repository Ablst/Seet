# Copy to .env only when supplying your own configuration.
# The competition submission already includes its owner-approved .env.
AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-flash
PORT=4173

# Optional speech recognition model (default shown).
# AI_ASR_MODEL=mimo-v2.5-asr
# Optional listening address; default is loopback only.
# HOST=127.0.0.1
# Optional storage overrides; prefer absolute paths on a deployed server.
# USER_STORE=
# ANALYSIS_STORE=
